{
"Version": "2012-10-17",
"Statement": [
    {
    "Sid": "AWSConfigBucketPermissionsCheck",
    "Effect": "Allow",
    "Principal": {
        "Service": "config.amazonaws.com"
    },
    "Action": "s3:GetBucketAcl",
    "Resource": "arn:aws:s3:::myapp-config-326709068429"
    },
    {
    "Sid": "AWSConfigBucketDelivery",
    "Effect": "Allow",
    "Principal": {
        "Service": "config.amazonaws.com"
    },
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::myapp-config-326709068429/AWSLogs/326709068429/Config/*",
    "Condition": {
        "StringEquals": {
        "s3:x-amz-acl": "bucket-owner-full-control"
        }
    }
    }
]
}
